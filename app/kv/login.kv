<Login>
    FloatLayout:
        # Botão voltar
        MDIconButton:
            icon: "arrow-left"
            pos_hint: {"x": .02, "top": .98}
            theme_text_color: "Custom"
            text_color: 0.49, 0.77, 0.50, 1
            on_release: root.voltar()

        # Logo + título
        MDBoxLayout:
            orientation: "vertical"
            spacing: "5dp"
            adaptive_height: True
            size_hint_x: 0.7
            pos_hint: {"center_x": .5, "center_y": .83}

            Image:
                id: Logo
                opacity: 0
                source: "extras/LogoFinal.png"
                size_hint_y: None
                height: "120dp"
                allow_stretch: True
                keep_ratio: True

            MDLabel:
                id: Text
                opacity: 0
                text: "Entrar na conta"
                halign: "center"
                font_name: "extras/Montserrat-VariableFont_wght.ttf"
                theme_text_color: "Custom"
                text_color: 0.49, 0.77, 0.50, 1
                font_style: "H5"

        # Formulário
        MDBoxLayout:
            orientation: "vertical"
            spacing: "8dp"
            adaptive_height: True
            size_hint_x: 0.7
            pos_hint: {"center_x": .5, "center_y": .52}

            # Email
            MDTextField:
                id: TextFieldEmail
                opacity: 0
                hint_text: "Insira o seu e-mail aqui"
                mode: "round"
                icon_left: "email"
                multiline: False
                line_color_focus: 0.49, 0.77, 0.50, 1
                icon_left_color_normal: 0.49, 0.77, 0.50, 1
                icon_left_color_focus: 0.49, 0.77, 0.50, 1
                text_color_focus: 0.49, 0.77, 0.50, 1
                hint_text_color_normal: 0.49, 0.77, 0.50, .6

            # Password
            MDTextField:
                id: TextFieldPassword
                opacity: 0
                hint_text: "Insira a palavra-passe"
                password: True
                mode: "round"
                icon_left: "lock"
                multiline: False
                line_color_focus: 0.49, 0.77, 0.50, 1
                icon_left_color_normal: 0.49, 0.77, 0.50, 1
                icon_left_color_focus: 0.49, 0.77, 0.50, 1
                text_color_focus: 0.49, 0.77, 0.50, 1
                hint_text_color_normal: 0.49, 0.77, 0.50, .6

            # Botão para ver conteudo dos campos de password
            MDRoundFlatIconButton:
                id: Verpass
                opacity : 0
                text: "Ver palavra passe"
                icon: "eye-off"
                font_name: "extras/Montserrat-Bold.ttf"
                size_hint_x: 0.7
                pos_hint: {"center_x": .5}
                line_color: 0, 0, 0, 0
                text_color: 0.49, 0.77, 0.50, 1
                icon_color: 0.49, 0.77, 0.50, 1
                theme_text_color: "Custom"
                on_release:
                    root.toggle_password()

        # Botão
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            size_hint_x: 0.7
            pos_hint: {"center_x": .5, "center_y": .27}

            MDRoundFlatButton:
                id: btn
                opacity: 0
                text: "Fazer login"
                font_name: "extras/Montserrat-Bold.ttf"
                size_hint_x: 1
                line_color: 0.49, 0.77, 0.50, 1
                text_color: 0.49, 0.77, 0.50, 1
                md_bg_color: 1, 1, 1, 1
                on_release:
                    root.iniciar_login()

        # Erro
        MDLabel:
            id: erro_texto
            text: ""
            halign: "center"
            size_hint_x: .8
            pos_hint: {"center_x": .5, "center_y": .20}
            theme_text_color: "Custom"
            text_color: 1, 0, 0, 1