<device>:

    FloatLayout:

        MDIconButton:
            id: botao_grafico_humidade
            icon: "chart-box-outline"
            pos_hint: {"right": 0.76, "top": 0.98}
            theme_icon_color: "Custom"
            icon_color: 0.49, 0.77, 0.50, 1
            on_release: root.abrir_grafico_humidade()

        MDIconButton:
            id: botao_associar_rega
            icon: "water-plus"
            pos_hint: {"right": 0.88, "top": 0.98}
            theme_icon_color: "Custom"
            icon_color: 0.49, 0.77, 0.50, 1
            on_release: root.associar_rega()

        # =====================================================
        # BOTÃO VOLTAR
        # =====================================================

        MDIconButton:
            id: botao_voltar
            icon: "home-outline"
            pos_hint: {"x": 0.02, "top": 0.98}
            theme_icon_color: "Custom"
            icon_color: 0.49, 0.77, 0.5, 1
            on_release:
                root.voltar()


        # =====================================================
        # BOTÃO DEFINIÇÕES
        # =====================================================

        MDIconButton:
            id: botao_definicoes
            icon: "cog-outline"
            pos_hint: {"right": 0.98, "top": 0.98}

            theme_icon_color: "Custom"
            icon_color: 0.49, 0.77, 0.5, 1

            on_release:
                root.abrir_definicoes()


        # =====================================================
        # IMAGEM DO DISPOSITIVO
        # =====================================================

        Image:
            id: device_image

            opacity: 0

            source: ""

            size_hint: None, None
            size: "120dp", "120dp"

            pos_hint:
                {"center_x": 0.5, "top": 0.87}

            allow_stretch: True
            keep_ratio: True


        # =====================================================
        # NOME DO DISPOSITIVO
        # =====================================================

        MDLabel:
            id: device_name

            opacity: 0

            text: ""

            font_name: "extras/Montserrat-Bold.ttf"
            font_size: "22sp"

            theme_text_color: "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            halign: "center"

            pos_hint:
                {"center_x": 0.5, "top": 0.69}

            size_hint_x: 0.85

            size_hint_y: None
            height: "40dp"


        # =====================================================
        # PLANTA
        # =====================================================

        MDLabel:
            id: plant_name

            opacity: 0

            text: "Planta não definida"

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size: "15sp"

            halign: "center"

            pos_hint:
                {"center_x": 0.5, "top": 0.63}

            size_hint_x: 0.85

            size_hint_y: None
            height: "30dp"


        # =====================================================
        # TEMPERATURA
        # =====================================================

        MDLabel:
            id: label_temperatura

            opacity: 0

            text: "Temperatura"

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size: "14sp"

            halign: "center"

            pos_hint:
                {"center_x": 0.25, "center_y": 0.51}

            size_hint_x: 0.3

            size_hint_y: None
            height: "30dp"


        MDLabel:
            id: temperatura

            opacity: 0

            text: "-- °C"

            font_name:
                "extras/Montserrat-Bold.ttf"

            font_size: "18sp"

            theme_text_color: "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            halign: "center"

            pos_hint:
                {"center_x": 0.25, "center_y": 0.46}

            size_hint_x: 0.3

            size_hint_y: None
            height: "30dp"


        # =====================================================
        # HUMIDADE DO AR
        # =====================================================

        MDLabel:
            id: label_humidade

            opacity: 0

            text: "Humidade do ar"

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size: "14sp"

            halign: "center"

            pos_hint:
                {"center_x": 0.75, "center_y": 0.51}

            size_hint_x: 0.4

            size_hint_y: None
            height: "30dp"


        MDLabel:
            id: humidade

            opacity: 0

            text: "-- %"

            font_name:
                "extras/Montserrat-Bold.ttf"

            font_size: "18sp"

            theme_text_color: "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            halign: "center"

            pos_hint:
                {"center_x": 0.75, "center_y": 0.46}

            size_hint_x: 0.3

            size_hint_y: None
            height: "30dp"


        # =====================================================
        # HUMIDADE DO SOLO
        # =====================================================

        MDLabel:
            id: label_humidade_solo

            opacity: 0

            text: "Humidade do solo"

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size: "14sp"

            halign: "center"

            pos_hint:
                {"center_x": 0.5, "center_y": 0.37}

            size_hint_x: 0.5

            size_hint_y: None
            height: "30dp"


        MDLabel:
            id: humidade_solo

            opacity: 0

            text: "-- %"

            font_name:
                "extras/Montserrat-Bold.ttf"

            font_size: "18sp"

            theme_text_color: "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            halign: "center"

            pos_hint:
                {"center_x": 0.5, "center_y": 0.32}

            size_hint_x: 0.3

            size_hint_y: None
            height: "30dp"

        # =====================================================
        # REGA MANUAL
        # =====================================================

        MDRoundFlatButton:
            id: botao_regar_manual
            text: "Regar"
            icon: "water"
            font_name: "extras/Montserrat-Bold.ttf"
            font_size: "11sp"
            size_hint: None, None
            size: "80dp", "38dp"
            pos_hint: {"x": 0.13, "top": 0.98}

            line_color: 0, 0, 0, 0
            md_bg_color: 1, 1, 1, 0
            text_color: 0.49, 0.77, 0.50, 1

            on_release: root.regar_manualmente()

        # =====================================================
        # HISTÓRICO DE AÇÕES
        # =====================================================

        MDLabel:
            id: label_historico
            opacity: 0
            text: "Histórico de ações"
            font_name: "extras/Montserrat-Bold.ttf"
            font_size: "18sp"
            theme_text_color: "Custom"
            text_color: 0.49, 0.77, 0.50, 1
            halign: "left"
            pos_hint:{"x": 0.08, "top": 0.25}
            size_hint_x: 0.84
            size_hint_y: None
            height: "35dp"


        MDLabel:
            id: historico_vazio
            opacity: 0
            text: ""
            font_name: "extras/Montserrat-VariableFont_wght.ttf"
            font_size: "15sp"
            halign: "center"
            pos_hint: {"center_x": 0.5, "top": 0.20}
            size_hint_x: 0.84
            size_hint_y: None
            height: "35dp"


        # =====================================================
        # =====================================================
        # PAINEL DE DEFINIÇÕES
        # =====================================================
        # =====================================================

        MDCard:
            id: settings_panel

            opacity: 0
            disabled: True

            size_hint: 0.90, 0.85

            pos_hint:
                {"center_x": 0.5, "center_y": 0.5}

            elevation: 4

            radius:
                [16, 16, 16, 16]

            md_bg_color:
                1, 1, 1, 1


            FloatLayout:


                # =================================================
                # BOTÃO VOLTAR
                # =================================================

                MDIconButton:
                    icon: "arrow-left"

                    pos_hint:
                        {"x": 0.02, "top": 0.98}

                    theme_icon_color:
                        "Custom"

                    icon_color:
                        0.49, 0.77, 0.50, 1

                    on_release:
                        root.fechar_definicoes()


                # =================================================
                # TÍTULO
                # =================================================

                MDLabel:
                    id: titulo_definicoes

                    text: "Definições"

                    font_name:
                        "extras/Montserrat-Bold.ttf"

                    font_size:
                        "22sp"

                    halign:
                        "center"

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.49, 0.77, 0.50, 1

                    pos_hint:
                        {"center_x": 0.5, "top": 0.90}

                    size_hint_y:
                        None

                    height:
                        "40dp"


                # =================================================
                # NOME DO DISPOSITIVO
                # =================================================

                MDLabel:
                    id: label_nome

                    text: "Nome do dispositivo"

                    font_name:
                        "extras/Montserrat-VariableFont_wght.ttf"

                    font_size:
                        "15sp"

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.49, 0.77, 0.50, 1

                    pos_hint:
                        {"x": 0.10, "top": 0.78}

                    size_hint_y:
                        None

                    height:
                        "30dp"


                MDTextField:
                    id: novo_nome

                    hint_text: "Nome"

                    mode: "round"

                    multiline: False

                    pos_hint:
                        {"center_x": 0.5, "top": 0.70}

                    size_hint_x:
                        0.80

                    line_color_normal:
                        0.49, 0.77, 0.50, 1

                    line_color_focus:
                        0.49, 0.77, 0.50, 1

                    text_color_focus:
                        0.30, 0.30, 0.30, 1

                    hint_text_color_normal:
                        0.49, 0.49, 0.49, 0.8


                # =================================================
                # ESPÉCIE DA PLANTA
                # =================================================

                MDLabel:
                    id: label_planta

                    text: "Espécie da planta"

                    font_name:
                        "extras/Montserrat-VariableFont_wght.ttf"

                    font_size:
                        "15sp"

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.49, 0.77, 0.50, 1

                    pos_hint:
                        {"x": 0.10, "top": 0.57}

                    size_hint_y:
                        None

                    height:
                        "30dp"


                # =================================================
                # BOTÃO SELECIONAR PLANTA
                # =================================================

                MDRoundFlatButton:
                    id: selecionar_planta

                    text: "Selecionar planta"

                    font_name:
                        "extras/Montserrat-Bold.ttf"

                    font_size:
                        "14sp"

                    size_hint_x:
                        0.80

                    pos_hint:
                        {"center_x": 0.5, "top": 0.49}

                    line_color:
                        0.49, 0.77, 0.50, 1

                    text_color:
                        0.49, 0.77, 0.50, 1

                    md_bg_color:
                        1, 1, 1, 1

                    on_release:
                        root.abrir_lista_plantas()


                # =================================================
                # BARRA DE PESQUISA
                # =================================================

                MDTextField:
                    id: pesquisa_planta

                    hint_text:
                        "Pesquisar espécie..."

                    mode:
                        "round"

                    multiline:
                        False

                    opacity:
                        0

                    disabled:
                        True

                    size_hint_x:
                        0.80

                    pos_hint:
                        {"center_x": 0.5, "top": 0.49}

                    line_color_normal:
                        0.49, 0.77, 0.50, 1

                    line_color_focus:
                        0.49, 0.77, 0.50, 1

                    text_color_focus:
                        0.30, 0.30, 0.30, 1

                    hint_text_color_normal:
                        0.49, 0.77, 0.50, 0.8

                    on_text:
                        root.filtrar_plantas(self.text)


                # =================================================
                # IMAGEM DO DISPOSITIVO
                # =================================================

                MDLabel:
                    id: label_imagem

                    text: "Imagem do dispositivo"

                    font_name:
                        "extras/Montserrat-VariableFont_wght.ttf"

                    font_size:
                        "15sp"

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.49, 0.77, 0.50, 1

                    pos_hint:
                        {"x": 0.10, "top": 0.38}

                    size_hint_y:
                        None

                    height:
                        "30dp"


                # =================================================
                # BOTÃO ESCOLHER IMAGEM
                # =================================================

                MDRoundFlatButton:
                    id: botao_imagem

                    text: "Escolher imagem"

                    font_name:
                        "extras/Montserrat-Bold.ttf"

                    font_size:
                        "14sp"

                    size_hint_x:
                        0.80

                    pos_hint:
                        {"center_x": 0.5, "top": 0.30}

                    line_color:
                        0.49, 0.77, 0.50, 1

                    text_color:
                        0.49, 0.77, 0.50, 1

                    md_bg_color:
                        1, 1, 1, 1

                    on_release:
                        root.escolher_imagem()


                # =================================================
                # BOTÃO GUARDAR
                # =================================================

                MDRoundFlatButton:
                    id: botao_guardar

                    text: "Guardar alterações"

                    font_name:
                        "extras/Montserrat-Bold.ttf"

                    font_size:
                        "14sp"

                    size_hint_x:
                        0.80

                    pos_hint:
                        {"center_x": 0.5, "top": 0.16}

                    line_color:
                        0.49, 0.77, 0.50, 1

                    text_color:
                        0.49, 0.77, 0.50, 1

                    md_bg_color:
                        1, 1, 1, 1

                    on_release:
                        root.guardar_alteracoes()

                # =================================================
                # BOTÃO DESASSOCIAR DISPOSITIVO
                # =================================================

                MDRoundFlatButton:
                    id: botao_desassociar
                    text: "Desassociar dispositivo"
                    font_name: "extras/Montserrat-Bold.ttf"
                    font_size: "14sp"
                    size_hint_x: 0.80
                    pos_hint: {"center_x": 0.5, "top": 0.08}

                    opacity: 0

                    line_color: 0.85, 0.25, 0.25, 1
                    text_color:0.85, 0.25, 0.25, 1
                    md_bg_color:1, 1, 1, 1

                    on_release:
                        root.desassociar_dispositivo()


                # =================================================
                # MENSAGEM
                # =================================================

                MDLabel:
                    id: mensagem_config

                    text: ""

                    font_name:
                        "extras/Montserrat-VariableFont_wght.ttf"

                    font_size:
                        "13sp"

                    halign:
                        "center"

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.49, 0.77, 0.50, 1

                    pos_hint:
                        {"center_x": 0.5, "top": 0.10}

                    size_hint_x:
                        0.80

                    size_hint_y:
                        None

                    height:
                        "30dp"


                # =================================================
                # DROPDOWN DAS PLANTAS
                # =================================================

                MDCard:
                    id: lista_plantas

                    opacity: 0
                    disabled: True

                    size_hint:
                        0.80, None

                    height:
                        0

                    pos_hint:
                        {"center_x": 0.5, "top": 0.405}

                    elevation:
                        0

                    radius:
                        [0, 0, 12, 12]

                    md_bg_color:
                        1, 1, 1, 1


                    ScrollView:

                        do_scroll_x:
                            False

                        do_scroll_y:
                            True

                        bar_width:
                            "3dp"


                        BoxLayout:
                            id: lista_resultados

                            orientation:
                                "vertical"

                            size_hint_y:
                                None

                            height:
                                self.minimum_height