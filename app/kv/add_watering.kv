<add_watering>:

    FloatLayout:

        # =====================================================
        # BOTÃO VOLTAR
        # =====================================================

        MDIconButton:
            id: botao_voltar

            icon: "arrow-left"

            pos_hint:
                {"x": .02, "top": .98}

            theme_icon_color:
                "Custom"

            icon_color:
                0.49, 0.77, 0.50, 1

            on_release:
                root.voltar()


        # =====================================================
        # LOGO
        # =====================================================

        Image:
            id: logo_add

            source:
                "extras/LogoFinal.png"

            size_hint:
                None, None

            size:
                "120dp", "60dp"

            pos_hint:
                {"center_x": .5, "top": .95}

            allow_stretch:
                True

            keep_ratio:
                True


        # =====================================================
        # TÍTULO
        # =====================================================

        MDLabel:
            id: titulo_add

            text:
                "Adicionar dispositivo de rega"

            font_name:
                "extras/Montserrat-Bold.ttf"

            font_size:
                "24sp"

            halign:
                "center"

            theme_text_color:
                "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            pos_hint:
                {"center_x": .5, "top": .75}

            size_hint_x:
                .8

            size_hint_y:
                None

            height:
                "40dp"


        # =====================================================
        # FASE 1 — CÓDIGO
        # =====================================================

        MDLabel:
            id: texto_explicativo

            text:
                "Insira o código do dispositivo de rega"

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size:
                "16sp"

            font_weight:
                500

            halign:
                "center"

            theme_text_color:
                "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            pos_hint:
                {"center_x": .5, "top": .66}

            size_hint_x:
                .8

            size_hint_y:
                None

            height:
                "30dp"


        MDTextField:
            id: TextFieldCodigo

            hint_text:
                "Código do dispositivo"

            mode:
                "round"

            icon_left:
                "water"

            multiline:
                False

            pos_hint:
                {"center_x": .5, "center_y": .53}

            size_hint_x:
                .8

            line_color_focus:
                0.49, 0.77, 0.50, 1

            icon_left_color_normal:
                0.49, 0.77, 0.50, 1

            icon_left_color_focus:
                0.49, 0.77, 0.50, 1

            text_color_focus:
                0.49, 0.77, 0.50, 1

            hint_text_color_normal:
                0.49, 0.77, 0.50, .6


        MDRoundFlatButton:
            id: btn

            text:
                "Continuar"

            font_name:
                "extras/Montserrat-Bold.ttf"

            size_hint_x:
                .8

            pos_hint:
                {"center_x": .5, "center_y": .40}

            line_color:
                0.49, 0.77, 0.50, 1

            text_color:
                0.49, 0.77, 0.50, 1

            md_bg_color:
                1, 1, 1, 1

            on_release:
                root.adicionar()


        # =====================================================
        # FASE 2 — ESCOLHER DISPOSITIVO DE RECOLHA
        # =====================================================

        MDLabel:
            id: texto_dispositivo

            text:
                "Escolha o dispositivo de recolha de dados"

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size:
                "16sp"

            font_weight:
                500

            halign:
                "center"

            theme_text_color:
                "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            pos_hint:
                {"center_x": .5, "top": .66}

            size_hint_x:
                .8

            size_hint_y:
                None

            height:
                "30dp"

            opacity: 0


        MDRaisedButton:
            id: btn_dispositivo

            text: "Selecionar dispositivo"

            font_name:
                "extras/Montserrat-Bold.ttf"

            size_hint_x:
                .8

            pos_hint:
                {"center_x": .5, "center_y": .53}

            md_bg_color:
                1, 1, 1, 1

            text_color:
                0.49, 0.77, 0.50, 1

            opacity: 0

            disabled: True

            on_release:
                root.abrir_dispositivos()


        MDRoundFlatButton:
            id: btn_dispositivo_continuar

            text: "Continuar"

            font_name:
                "extras/Montserrat-Bold.ttf"

            size_hint_x: .8

            pos_hint:
                {"center_x": .5, "center_y": .40}

            line_color:
                0.49, 0.77, 0.50, 1

            text_color:
                0.49, 0.77, 0.50, 1

            md_bg_color:
                1, 1, 1, 1

            opacity: 0

            disabled: True

            on_release:
                root.mostrar_configuracao_wifi()


        # =====================================================
        # FASE 3 — CONFIGURAÇÃO WI-FI
        # =====================================================

        MDLabel:
            id: texto_wifi

            text:
                "Associe o dispositivo à sua rede Wi-Fi"

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size:
                "16sp"

            font_weight:
                500

            halign:
                "center"

            theme_text_color:
                "Custom"

            text_color:
                0.49, 0.77, 0.50, 1

            pos_hint:
                {"center_x": .5, "top": .66}

            size_hint_x:
                .8

            size_hint_y:
                None

            height:
                "30dp"

            opacity: 0


        MDTextField:
            id: campo_ssid

            hint_text:
                "Nome da rede Wi-Fi"

            mode:
                "round"

            icon_left:
                "wifi"

            multiline:
                False

            pos_hint:
                {"center_x": .5, "center_y": .53}

            size_hint_x:
                .8

            line_color_focus:
                0.49, 0.77, 0.50, 1

            icon_left_color_normal:
                0.49, 0.77, 0.50, 1

            icon_left_color_focus:
                0.49, 0.77, 0.50, 1

            text_color_focus:
                0.49, 0.77, 0.50, 1

            hint_text_color_normal:
                0.49, 0.77, 0.50, .6

            opacity: 0

            disabled: True


        MDTextField:
            id: campo_password

            hint_text:
                "Password da rede"

            mode:
                "round"

            icon_left:
                "lock"

            password:
                True

            multiline:
                False

            pos_hint:
                {"center_x": .5, "center_y": .44}

            size_hint_x:
                .8

            line_color_focus:
                0.49, 0.77, 0.50, 1

            icon_left_color_normal:
                0.49, 0.77, 0.50, 1

            icon_left_color_focus:
                0.49, 0.77, 0.50, 1

            text_color_focus:
                0.49, 0.77, 0.50, 1

            hint_text_color_normal:
                0.49, 0.77, 0.50, .6

            opacity: 0

            disabled: True


        MDRoundFlatButton:
            id: btn_wifi

            text:
                "Associar Wi-Fi"

            font_name:
                "extras/Montserrat-Bold.ttf"

            size_hint_x:
                .8

            pos_hint:
                {"center_x": .5, "center_y": .32}

            line_color:
                0.49, 0.77, 0.50, 1

            text_color:
                0.49, 0.77, 0.50, 1

            md_bg_color:
                1, 1, 1, 1

            on_release:
                root.associar_wifi()

            opacity: 0

            disabled: True


        # =====================================================
        # MENSAGEM
        # =====================================================

        MDLabel:
            id: erro_texto

            text:
                ""

            font_name:
                "extras/Montserrat-VariableFont_wght.ttf"

            font_size:
                "14sp"

            halign:
                "center"

            text_color:
                0.49, 0.77, 0.50, 1

            pos_hint:
                {"center_x": .5, "center_y": .22}

            size_hint_x:
                .8